<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AIUsage</RootNamespace>
    <AssemblyName>AIUsage</AssemblyName>
    <ApplicationIcon>Resources\appicon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Web assets are embedded (not copied), so the published single-file exe is fully
       self-contained. LogicalName keeps the folder structure via %(RecursiveDir); the app
       extracts them next to a cache dir at startup (see WebAssets.EnsureExtracted). -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*">
      <LogicalName>web/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Also embedded so the Photino window icon can be set at runtime in single-file mode. -->
    <EmbeddedResource Include="Resources\appicon.ico">
      <LogicalName>appicon.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The test project lives in a subfolder of this one; keep its sources out of the app's
       default **/*.cs compile glob (otherwise the app tries to compile the tests). -->
  <ItemGroup>
    <Compile Remove="AIUsage.Tests\**\*.cs" />
    <EmbeddedResource Remove="AIUsage.Tests\**" />
    <None Remove="AIUsage.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="Porta.Pty" Version="1.0.7" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
  </ItemGroup>

</Project>
