<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AIUsage</RootNamespace>
    <AssemblyName>AIUsage</AssemblyName>
    <ApplicationIcon>Resources\appicon.ico</ApplicationIcon>
    <!-- App version (semver). Bump by hand when a change is worth a release; read at runtime
         via Platform/AppVersion.cs. The git commit hash below is appended automatically as
         "+<hash>" onto AssemblyInformationalVersion (SourceRevisionId is an SDK-recognized
         property, wired up by AddSourceRevisionToInformationalVersion in
         Microsoft.NET.GenerateAssemblyInfo.targets — no SourceLink package needed). -->
    <Version>1.0.1</Version>
  </PropertyGroup>

  <!-- Stamps the git short commit hash (if available) and UTC build date, both best-effort:
       a build outside a git checkout (no git installed, or a plain zip of the source) must
       still succeed, just without a commit hash. -->
  <Target Name="SetGitCommitHash" BeforeTargets="InitializeSourceControlInformation">
    <Exec Command="git rev-parse --short=7 HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          ContinueOnError="WarnAndContinue"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitHash" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_GitExitCode)' == '0' and '$(_GitCommitHash)' != ''">
      <SourceRevisionId>$(_GitCommitHash)</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))" />
  </ItemGroup>

  <!-- Web assets are embedded (not copied), so the published single-file exe is fully
       self-contained. LogicalName keeps the folder structure via %(RecursiveDir); the app
       extracts them next to a cache dir at startup (see WebAssets.EnsureExtracted). -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*">
      <LogicalName>web/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Also embedded so the Photino window icon can be set at runtime in single-file mode. -->
    <EmbeddedResource Include="Resources\appicon.ico">
      <LogicalName>appicon.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The test project lives in a subfolder of this one; keep its sources out of the app's
       default **/*.cs compile glob (otherwise the app tries to compile the tests). -->
  <ItemGroup>
    <Compile Remove="AIUsage.Tests\**\*.cs" />
    <EmbeddedResource Remove="AIUsage.Tests\**" />
    <None Remove="AIUsage.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="Porta.Pty" Version="1.0.7" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
  </ItemGroup>

</Project>
